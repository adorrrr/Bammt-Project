# Environment & Sensitive Credentials
.env
.env.*
!.env.example

# Server & Error Logs
*.log
error_log
logs/

# Database dumps & local backups (schema.sql is preserved)
*.sql.gz
*.bak
*.backup
*.dump
backup/

# User Uploaded Student Photos (keeps directory structure intact)
uploads/photos/*
!uploads/photos/.gitkeep
!uploads/photos/.htaccess

# OS & Editor Metadata
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.sublime-workspace
*.sublime-project

# Temporary / Cache Files
*.tmp
*.temp
.cache/
